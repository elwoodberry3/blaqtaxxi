# BLAQTAXXI — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# APP_ENV decides how missing values behave:
#   demo        every variable optional; demo fallbacks; fake data; chips on
#   staging     client review; Stripe TEST keys; chips on
#   production  every required integration MUST be set or the app refuses to boot; chips off
APP_ENV=demo
NEXT_PUBLIC_SHOW_TODO_CHIPS=true          # must be false/unset in production
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000   # production: https://www.blaqtaxxi.com

# --- Google Maps Platform (Phase 2, 3, 5) ---
# Two DIFFERENT keys. The server key must never be shipped to the browser.
GOOGLE_MAPS_SERVER_KEY=                   # Routes / Geocoding; restrict server-side
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=      # Maps JS + Places; restrict by HTTP referrer

# --- Database and cache (Phase 4, 5) ---
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (Phase 4) ---
AUTH_SECRET=
ADMIN_EMAIL=                              # allow-listed admin/driver identity
# Secret (pepper) used when hashing customer link tokens
LINK_TOKEN_PEPPER=

# --- Payments (Phase 6) ---
# TEST keys everywhere except production after the Phase 9 sign-off.
# The live Stripe account must be owned by the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Notifications (Phase 7) ---
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- n8n Cloud (Phase 7) ---
# Header: Authorization: Bearer <N8N_BEARER>  (exact key, "Bearer " prefix)
N8N_WEBHOOK_BASE=https://iautomateshit.app.n8n.cloud/webhook
N8N_BEARER=

# --- Observability (Phase 8) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Claude Code MCP servers (.mcp.json reads these from your terminal environment, not this file) ---
# export GITHUB_PAT=...
# export STRIPE_TEST_RESTRICTED_KEY=...     # restricted, TEST-mode key only
# export N8N_API_URL=https://iautomateshit.app.n8n.cloud
# export N8N_API_KEY=...
