# BLAQTAXXI — environment variables
# Copy to .env.local and fill in. Every variable is OPTIONAL: with none set, the app runs in demo mode.
# Never commit .env.local. Never put a live Stripe key in Preview.

# --- Routing / Places (Phase 2, 3) ---
# Unset => demo travel model (fixtures), labeled "illustrative"
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_KEY=

# --- Database (Phase 4) ---
# Unset => in-memory store seeded from fixtures
DATABASE_URL=

# --- Redis / rate limits / ping store (Phase 4, 5) ---
# Unset => in-memory Map with TTL
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (Phase 4) ---
# Unset => dev-only "Sign in as driver" button (disabled in production)
AUTH_SECRET=
DRIVER_EMAIL=
# Secret used to hash magic-link ride tokens
RIDE_TOKEN_PEPPER=

# --- Payments (Phase 6) — TEST MODE ONLY ---
# Unset => simulated payments and refunds
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Notifications (Phase 7) ---
# Unset => logged to /dev/outbox
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- n8n Cloud (Phase 7) ---
# Base URL for workflow webhooks, and the shared Bearer secret (header: Authorization: Bearer <value>)
N8N_WEBHOOK_BASE=https://iautomateshit.app.n8n.cloud/webhook
N8N_BEARER=

# --- Observability (Phase 8) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Claude Code MCP servers (.mcp.json reads these from your shell, not from .env.local) ---
# export GITHUB_PAT=...
# export STRIPE_TEST_RESTRICTED_KEY=...   # restricted, test-mode key only
# export N8N_API_URL=https://iautomateshit.app.n8n.cloud
# export N8N_API_KEY=...
