# BLAQTAXXI — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# APP_ENV decides how missing values behave:
#   demo        course/local; every variable optional; demo fallbacks; fake data; chips on
#   pilot       IAS-hosted (blaqtaxxi.iasbootcamp.com); real client config; public may use it up to
#               payment; Stripe TEST keys only; PilotBanner + feedback; no chips; MUST fail boot if a
#               required integration is missing
#   production  the CLIENT's own deployment on his own accounts; live payments; MUST fail boot if a
#               required integration is missing; no chips, no pilot banner
APP_ENV=demo
NEXT_PUBLIC_SHOW_TODO_CHIPS=true          # demo only. Must be false/unset in pilot and production
NEXT_PUBLIC_PILOT_BANNER=false            # true in pilot only
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000   # pilot: https://blaqtaxxi.iasbootcamp.com ; production: the client's domain

# --- Pilot only ---
PILOT_TEST_PAYMENT_ALLOWLIST=             # comma-separated emails allowed to complete a Stripe TEST payment
FEEDBACK_WEBHOOK=                         # n8n webhook that receives in-app feedback

# --- Google Maps Platform (Phase 2, 3, 5) ---
# Two DIFFERENT keys. The server key must never be shipped to the browser.
GOOGLE_MAPS_SERVER_KEY=                   # Routes / Geocoding; restrict server-side
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=      # Maps JS + Places; restrict by HTTP referrer

# --- Database and cache (Phase 4, 5) ---
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (Phase 4) --- assumed Vercel Blob (limits/pricing unverified)
BLOB_READ_WRITE_TOKEN=

# --- Auth (Phase 4) ---
AUTH_SECRET=
ADMIN_EMAIL=                              # allow-listed admin/driver identity
LINK_TOKEN_PEPPER=                        # secret used when hashing customer link tokens

# --- Payments (Phase 6) ---
# TEST keys in demo and pilot. A LIVE key exists only in the client's own production deployment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Notifications (Phase 7) --- in pilot: no SMS to the public; email to allow-listed testers only
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- n8n Cloud (Phase 7) ---
# Header: Authorization: Bearer <N8N_BEARER>  (exact key, "Bearer " prefix)
N8N_WEBHOOK_BASE=https://iautomateshit.app.n8n.cloud/webhook
N8N_BEARER=

# --- Observability (Phase 8) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Claude Code MCP servers (.mcp.json reads these from your terminal environment, not this file) ---
# export GITHUB_PAT=...
# export STRIPE_TEST_RESTRICTED_KEY=...     # restricted, TEST-mode key only
# export N8N_API_URL=https://iautomateshit.app.n8n.cloud
# export N8N_API_KEY=...
